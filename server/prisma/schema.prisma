datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CUSTOMER
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  COD
  BKASH
  NAGAD
  CARD
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

enum InventoryTransactionType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  RESTOCK
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role     @default(ADMIN)
  permissions  String[] @default([])
  isActive     Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  refreshTokenHash String?

  inventoryTransactions InventoryTransaction[]

  @@map("users")
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorName   String
  actorEmail  String
  actorRole   String
  module      String
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  summary     String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([module, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("admin_audit_logs")
}

model Customer {
  id           String    @id @default(uuid())
  email        String?   @unique
  phone        String?   @unique
  firstName    String
  lastName     String?
  passwordHash String?
  photoUrl     String?
  isActive     Boolean   @default(true)
  banReason    String?
  bannedAt     DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  refreshTokenHash String?
  resetTokenHash String?
  resetTokenExpiresAt DateTime?
  secondaryPhone String?
  dateOfBirth DateTime?
  preferredSize String?
  preferredFit String?
  marketingConsent Boolean @default(false)

  identities AuthIdentity[]
  addresses  Address[]
  orders     Order[]
  reviews    Review[]
  cart       Cart?
  wishlistItems WishlistItem[]
  measurements CustomerMeasurementProfile?
  reviewVotes ReviewVote[]

  @@index([isActive, deletedAt])
  @@index([deletedAt])
  @@map("customers")
}

model AuthIdentity {
  id             String       @id @default(uuid())
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  providerEmail  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([provider, providerUserId])
  @@index([customerId])
  @@map("auth_identities")
}

model Address {
  id           String   @id @default(uuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  addressLine1 String
  addressLine2 String?
  city         String
  division     String   // e.g. Dhaka, Chittagong
  postalCode   String?
  country      String   @default("Bangladesh")
  isDefault    Boolean  @default(false)
  phone        String
  fullName String?
  email String?
  area String?
  deliveryInstructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("addresses")
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  seoTitle    String?
  metaDescription String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  products Product[]
  offers   Offer[]    @relation("OfferCategories")

  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  description    String?
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  costPrice      Decimal? @db.Decimal(10, 2)
  sku            String   @unique
  gender         Gender   @default(MEN)
  fabric         String?
  fit            String?
  shortDescription String?
  fabricOrigin String?
  gsm Int?
  careInstructions String?
  isExpressAvailable Boolean @default(false)
  tags String[] @default([])
  alertThreshold Int      @default(5)
  isActive       Boolean  @default(true)
  deletedAt      DateTime?
  isFeatured     Boolean  @default(false)
  isNewArrival   Boolean  @default(false)
  isBestSeller   Boolean  @default(false)
  seoTitle       String?
  metaDescription String?
  canonicalUrl   String?
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  variants   ProductVariant[]
  images     ProductImage[]
  reviews    Review[]
  orderItems OrderItem[]
  cartItems CartItem[]
  wishlistItems WishlistItem[]
  sourceRelations ProductRelation[] @relation("ProductRelationSource")
  targetRelations ProductRelation[] @relation("ProductRelationTarget")
  slugRedirects   ProductSlugRedirect[]
  offers          Offer[]               @relation("OfferProducts")
  collections     Collection[]          @relation("CollectionProducts")

  @@index([isActive, createdAt])
  @@index([isActive, deletedAt])
  @@index([categoryId, isActive])
  @@index([gender, isActive])
  @@index([isFeatured, isActive])
  @@index([isBestSeller, isActive])
  @@map("products")
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size          String   // e.g. 38, 40, 42, 44, S, M, L, XL
  color         String   // e.g. Heritage Olive, Midnight Navy
  sku           String   @unique
  stock         Int      @default(0)
  priceOverride Decimal? @db.Decimal(10, 2)
  sizeLabel String?
  sizeType String?
  measurements Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventoryTransactions InventoryTransaction[]
  orderItems            OrderItem[]
  cartItems CartItem[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  publicId  String?
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_images")
}

model InventoryTransaction {
  id             String                   @id @default(uuid())
  variantId      String
  variant        ProductVariant           @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantityChange Int                      // e.g. +10, -2
  previousStock  Int
  newStock       Int
  type           InventoryTransactionType
  note           String?
  userId         String?
  user           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime                 @default(now())

  @@map("inventory_transactions")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // e.g. #RL1001
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  guestName String?
  guestEmail String?
  guestPhone String?
  trackingTokenHash String?
  courierName String?
  trackingNumber String?
  trackingUrl String?
  courierProvider String?
  courierOrderId String?
  courierConsignmentId String?
  courierStatus String?
  courierTrackingUrl String?
  courierCreatedAt DateTime?
  courierResponseMetadata Json?
  estimatedDelivery DateTime?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  paymentReference String?
  paidAmount      Decimal?      @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(10, 2)
  manualDiscountAmount Decimal  @default(0.00) @db.Decimal(10, 2)
  deliveryCharge  Decimal       @default(80.00) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  shippingAddress Json
  customerNotes   String?
  adminNotes      String?
  source          String?       @default("STOREFRONT")
  createdById     String?
  createdByName   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]
  trackingEvents OrderTrackingEvent[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName String
  variantName String
  sku         String
  unitPrice   Decimal        @db.Decimal(10, 2)
  quantity    Int
  subtotal    Decimal        @db.Decimal(10, 2)
  size        String?
  color       String?
  discountAmount Decimal     @default(0.00) @db.Decimal(10, 2)
  productImage String?
  createdAt   DateTime       @default(now())

  @@map("order_items")
}

model Coupon {
  id                 String     @id @default(uuid())
  code               String     @unique
  description        String?
  type               CouponType @default(PERCENTAGE)
  value              Decimal    @db.Decimal(10, 2)
  minimumOrderAmount Decimal    @default(0.00) @db.Decimal(10, 2)
  maximumDiscount    Decimal?   @db.Decimal(10, 2)
  startDate          DateTime   @default(now())
  expiryDate         DateTime
  usageLimit         Int?
  usageCount         Int        @default(0)
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@map("coupons")
}

model Review {
  id         String       @id @default(uuid())
  customerId String
  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  rating     Int          // 1-5
  comment    String
  images     String[]     @default([])
  status     ReviewStatus @default(PENDING)
  adminFeedback String?
  adminFeedbackAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  votes ReviewVote[]

  @@index([productId, status, createdAt])
  @@index([customerId, productId])
  @@map("reviews")
}

model Cart {
  id String @id @default(uuid())
  customerId String? @unique
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestId String? @unique
  guestEmail String?
  guestPhone String?
  guestName String?
  lastReminderSentAt DateTime?
  reminderCount Int @default(0)
  items CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
  @@map("carts")
}

model CartItem {
  id String @id @default(uuid())
  cartId String
  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id String @id @default(uuid())
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([customerId, productId])
  @@map("wishlist_items")
}

model CustomerMeasurementProfile {
  id String @id @default(uuid())
  customerId String @unique
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  chest Decimal? @db.Decimal(6, 2)
  shoulder Decimal? @db.Decimal(6, 2)
  sleeveLength Decimal? @db.Decimal(6, 2)
  collar Decimal? @db.Decimal(6, 2)
  waist Decimal? @db.Decimal(6, 2)
  trouserLength Decimal? @db.Decimal(6, 2)
  garmentLength Decimal? @db.Decimal(6, 2)
  tailoringNotes String?
  updatedAt DateTime @updatedAt

  @@map("customer_measurement_profiles")
}

model OrderTrackingEvent {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status OrderStatus
  description String?
  customerVisible Boolean @default(true)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_tracking_events")
}

model ProductRelation {
  id String @id @default(uuid())
  sourceProductId String
  sourceProduct Product @relation("ProductRelationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProductId String
  targetProduct Product @relation("ProductRelationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  relationType String @default("RELATED")
  sortOrder Int @default(0)

  @@unique([sourceProductId, targetProductId, relationType])
  @@index([sourceProductId, relationType, sortOrder])
  @@map("product_relations")
}

model ReviewVote {
  id String @id @default(uuid())
  reviewId String
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  customerId String
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  helpful Boolean
  createdAt DateTime @default(now())

  @@unique([reviewId, customerId])
  @@map("review_votes")
}

model NewsletterSubscriber {
  id String @id @default(uuid())
  email String @unique
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model StoreSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  group       String   @default("general") // general, delivery, payment
  description String?
  updatedAt   DateTime @updatedAt

  @@map("store_settings")
}

model CustomerArchive {
  id             String    @id @default(uuid())
  originalId     String
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  secondaryPhone String?
  addresses      Json?
  measurements   Json?
  ordersSnapshot Json?
  totalSpent     Decimal   @default(0.00) @db.Decimal(10, 2)
  totalOrders    Int       @default(0)
  deletedBy      String?
  deleteReason   String?
  deletedAt      DateTime  @default(now())

  @@index([originalId])
  @@index([email])
  @@index([phone])
  @@map("customer_archives")
}

model ProductSlugRedirect {
  id         String   @id @default(uuid())
  sourceSlug String   @unique
  targetSlug String
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([sourceSlug])
  @@index([productId])
  @@map("product_slug_redirects")
}

enum OfferType {
  PRODUCT_DISCOUNT
  CATEGORY_DISCOUNT
  STOREWIDE
  BUNDLE
}

enum OfferDiscountType {
  PERCENTAGE
  FIXED
}

model Offer {
  id             String            @id @default(uuid())
  name           String
  slug           String            @unique
  description    String?
  bannerTitle    String?
  bannerSubtitle String?
  bannerMessage  String?
  offerType      OfferType         @default(PRODUCT_DISCOUNT)
  discountType   OfferDiscountType @default(PERCENTAGE)
  discountValue  Decimal           @db.Decimal(10, 2)
  startDate      DateTime          @default(now())
  expiryDate     DateTime
  isActive       Boolean           @default(true)
  badgeText      String?
  couponCode     String?
  priority       Int               @default(0)

  products       Product[]         @relation("OfferProducts")
  categories     Category[]        @relation("OfferCategories")
  collections    Collection[]      @relation("OfferCollections")

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([isActive, startDate, expiryDate])
  @@index([slug])
  @@map("offers")
}

model Collection {
  id              String     @id @default(uuid())
  name            String
  slug            String     @unique
  tagline         String?
  description     String?
  image           String?
  isActive        Boolean    @default(true)
  sortOrder       Int        @default(0)
  seoTitle        String?
  metaDescription String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  products        Product[]  @relation("CollectionProducts")
  offers          Offer[]    @relation("OfferCollections")

  @@index([isActive, sortOrder])
  @@index([slug])
  @@map("collections")
}

